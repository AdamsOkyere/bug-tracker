generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id         String         @id @default(cuid())
  reference  String         @unique
  name       String?
  email      String?
  type       FeedbackType
  title      String         @db.VarChar(120)
  message    String         @db.VarChar(5000)
  severity   Severity?
  pageUrl    String?        @db.VarChar(2048)
  status     FeedbackStatus @default(NEW)
  adminNotes String?        @db.VarChar(10000)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}